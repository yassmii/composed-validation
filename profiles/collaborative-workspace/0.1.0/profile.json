    "requiredOperations": ["describe", "reset", "execute", "inspect", "inject", "dispose"],
    "constraints": [
      "Translate only documented public product operations.",
      "Use fixture-scoped, disposable workspaces, identities, credentials, repositories, and storage.",
      "Do not provide a privileged path that a production principal or operator lacks.",
      "Redact secrets, protected values, and inaccessible content before returning diagnostics or artifacts.",
